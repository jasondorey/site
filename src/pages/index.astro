---
import Base from "../layouts/Base.astro";
import tie from "../assets/headshot-tie.webp";
import speaking from "../assets/speaking.webp";
import graduation from "../assets/cisb-graduation.webp";
import campsite from "../assets/matata-campsite.webp";
import LogoMark from "../components/LogoMark.astro";
import { formatDates, pageDescription, pageTitle, profile } from "../data/profile.js";

const cardPhotos = {
  speaking,
  graduation,
  campsite,
};

const cardPhotoAlts = {
  graduation: "Graduates in red gowns tossing caps in front of the Canadian International School of Beijing.",
  campsite: "Lit tents in a field at night, with the Matata mark.",
};

const selectedExperience = profile.experience.filter(
  (job) => job.slug !== "glg" && job.slug !== "ibo",
);
---

<Base title={pageTitle} description={pageDescription} current="work">
  <main id="content">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="window">
        <div class="window-bar" aria-hidden="true">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="window-content">
          <div class="hero-copy">
            <h1 id="hero-heading">
              I help learning organizations turn digital and AI initiatives into lasting capability.
            </h1>
            <p class="hero-about">
              {profile.currentTitle}
              <span>{profile.currentOrg}</span>
            </p>
          </div>
          <img
            class="hero-portrait"
            src={tie.src}
            width={tie.width}
            height={tie.height}
            alt={profile.portraits.primaryAlt}
            fetchpriority="high"
          />
        </div>
      </div>
      <a class="scroll-cue" href="#experience">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        Selected experience
      </a>
    </section>

    <section class="projects" id="experience" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="sr-only">Selected experience</h2>
      <div class="project-list">
        {
          selectedExperience.map((job) => {
            const photo = cardPhotos[job.visual] ?? cardPhotos[job.cardPhoto];
            return (
            <a class="project-card" href={`/experience/${job.slug}`}>
              <span class="card-top">
                <span class="card-heading">
                  <LogoMark slug={job.slug} />
                  <span class="card-title">{job.title}</span>
                </span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 17L17 7M17 7H9M17 7v8" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
              <span class="card-desc">
                <span class="card-org">{job.org}, {formatDates(job)}</span>
                {" — "}
                {job.points[0]}
              </span>
              {photo ? (
                <img
                  src={photo.src}
                  width={photo.width}
                  height={photo.height}
                  alt={cardPhotoAlts[job.cardPhoto] ?? ""}
                />
              ) : (
                <span class="card-field" aria-hidden="true">{formatDates(job)}</span>
              )}
            </a>
            );
          })
        }
      </div>
    </section>
  </main>
</Base>
