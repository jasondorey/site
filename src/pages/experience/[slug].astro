---
import Base from "../../layouts/Base.astro";
import speaking from "../../assets/speaking.webp";
import cisbLibrary from "../../assets/cisb-coordinator.webp";
import matataCampsite from "../../assets/matata-campsite.webp";
import matataCanyoning from "../../assets/matata-canyoning.webp";
import matataPortrait from "../../assets/matata-portrait.webp";
import LogoMark from "../../components/LogoMark.astro";
import { profile } from "../../data/profile.js";
import { akdPortfolio } from "../../data/portfolio.js";

export function getStaticPaths() {
  return profile.experience.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props;
const appointments = job.roles ?? [
  { title: job.title, start: job.start, end: job.end, points: job.points },
];
const title = `${job.title} — ${profile.name}`;
const description = `${appointments[0].title}, ${job.org}. ${appointments[0].points[0]}`;
const figures = {
  speaking: {
    image: speaking,
    alt: profile.speaking.alt,
    caption: profile.speaking.caption,
  },
  library: {
    image: cisbLibrary,
    alt: "Jason Dorey in a navy suit, standing in a school library. The photo is labeled Jason Dorey, IB Diploma Program Coordinator.",
    caption: "IB Diploma Program Coordinator, in the school library.",
  },
};
const figure = figures[job.detailFigure] ?? (job.visual === "speaking" ? figures.speaking : null);
---

<Base title={title} description={description} current="work">
  <main id="content" class="detail">
    <LogoMark slug={job.slug} class="detail-logo" />
    <p class="overline">{job.org}</p>
    {
      appointments.map((role, index) => (
        <section class="appointment">
          {index === 0 ? <h1>{role.title}</h1> : <h2>{role.title}</h2>}
          <p class="detail-dates">
            {job.place && <span class="detail-place">{job.place}</span>}
            <time datetime={role.start.datetime}>{role.start.label}</time>
            {" – "}
            {role.end ? <time datetime={role.end.datetime}>{role.end.label}</time> : "Present"}
          </p>
          {index === 0 && figure && (
            <figure>
              <img
                src={figure.image.src}
                width={figure.image.width}
                height={figure.image.height}
                alt={figure.alt}
              />
              <figcaption>{figure.caption}</figcaption>
            </figure>
          )}
          {index === 0 && job.slug === "matata" && (
            <div class="detail-gallery">
              <img
                class="is-wide"
                src={matataCampsite.src}
                width={matataCampsite.width}
                height={matataCampsite.height}
                alt="Lit tents in a field at night, with the Matata mark."
              />
              <img
                src={matataPortrait.src}
                width={matataPortrait.width}
                height={matataPortrait.height}
                alt="Jason Dorey in a Matata polo."
              />
              <img
                src={matataCanyoning.src}
                width={matataCanyoning.width}
                height={matataCanyoning.height}
                alt="People on ropes in a rocky canyon, with the Matata mark."
              />
            </div>
          )}
          <ul>
            {role.points.map((point) => <li>{point}</li>)}
          </ul>
        </section>
      ))
    }
    {
      job.slug === "akd" && (
        <section class="portfolio" aria-labelledby="portfolio-heading">
          <h2 id="portfolio-heading" class="overline">
            Portfolio
          </h2>
          <ul class="portfolio-grid">
            {akdPortfolio.map((org) => {
              const logo = org.logo;
              const src = typeof logo === "string" ? logo : logo.src;
              const width = typeof logo === "string" ? 964 : logo.width;
              const height = typeof logo === "string" ? 280 : logo.height;
              return (
                <li>
                  <a href={org.href} target="_blank" rel="noopener noreferrer">
                    <span class="org-well">
                      <img src={src} width={width} height={height} alt="" />
                    </span>
                    <span class="org-name">{org.name}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </main>
</Base>
